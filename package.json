{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npx vite preview",
    "server": "tsx watch server/index.ts",
    "server:dev": "nodemon --watch server --exec tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "community:sync": "tsx server/scripts/sync-community.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.1",
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^11.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.11.0",
    "svix": "^1.86.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "concurrently": "^9.2.1",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "nodemon": "^3.1.11",
    "postcss": "latest",
    "prisma": "^6.19.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "^5.2.0"
  }
}
