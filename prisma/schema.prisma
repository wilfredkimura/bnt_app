generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int                @id @default(autoincrement())
  email              String             @unique
  role               Role               @default(Volunteer)
  subscriptionStatus SubscriptionStatus @default(Inactive)
  createdAt          DateTime           @default(now())
  name               String
  password           String             @default("")
  clerkId            String?            @unique
  lastLogin          DateTime?
  donations          Donation[]
  requests           UserRequest[]

  @@map("users")
}

model Book {
  id             Int            @id @default(autoincrement())
  title          String
  author         String
  curriculum     CurriculumType @default(CBC)
  isKicdApproved Boolean        @default(false)
  createdAt      DateTime       @default(now())
  trunkId        Int?
  trunk          Trunk?         @relation(fields: [trunkId], references: [id])

  @@map("books")
}

model Trunk {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  status       TrunkStatus @default(Planned)
  dispatchedAt DateTime?
  locationId   Int?
  books        Book[]
  location     Location?   @relation(fields: [locationId], references: [id])

  @@map("trunks")
}

model Location {
  id          Int     @id @default(autoincrement())
  name        String
  latitude    Float
  longitude   Float
  description String?
  partnerOrg  String?
  trunks      Trunk[]

  @@map("locations")
}

model Report {
  id         Int            @id @default(autoincrement())
  title      String
  filePath   String
  category   ReportCategory @default(Financial)
  uploadedAt DateTime       @default(now())

  @@map("reports")
}

model Donation {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  currency  Currency @default(KES)
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  @@map("donations")
}

model AdminConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_config")
}

model Story {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  author    String
  location  String?
  imageUrl  String?
  published Boolean  @default(false)
  featured  Boolean  @default(false)
  readTime  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, featured])
  @@index([slug])
  @@map("stories")
}

model ImpactMetric {
  id           String   @id @default(cuid())
  metricType   String
  value        Int
  label        String
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("impact_metrics")
}

model GalleryItem {
  id           String    @id @default(cuid())
  imageUrl     String
  caption      String?
  location     String?
  eventDate    DateTime?
  tags         String[]
  featured     Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id])

  @@index([featured, displayOrder])
  @@index([eventId])
  @@map("gallery_items")
}

model CommunityMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  bio        String?
  photoUrl   String?
  email      String?  @unique
  phone      String?
  location   String?
  joinedDate DateTime @default(now())
  isActive   Boolean  @default(true)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tags       String[]

  @@index([isActive, featured])
  @@map("community_members")
}

model Event {
  id               String        @id @default(cuid())
  title            String
  description      String
  location         String
  eventDate        DateTime
  endDate          DateTime?
  imageUrl         String?
  eventType        String
  attendees        Int           @default(0)
  booksDistributed Int           @default(0)
  published        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  galleryItems     GalleryItem[]

  @@index([published, eventDate])
  @@map("events")
}

model UserRequest {
  id        String        @id @default(cuid())
  type      RequestType   @default(Custom)
  subject   String
  message   String
  status    RequestStatus @default(Pending)
  adminNote String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    Int
  user      User          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@map("user_requests")
}

enum CurriculumType {
  CBC
  Legacy844
  International
}

enum Role {
  Admin
  Volunteer
  Donor
  OrganisationLeader
}

enum SubscriptionStatus {
  Active
  Inactive
}

enum TrunkStatus {
  Planned
  InTransit @map("In_Transit")
  Delivered
}

enum ReportCategory {
  Financial
  Impact
  Planning
}

enum Currency {
  KES
  USD
  EUR
}

enum RequestStatus {
  Pending
  InProgress
  Completed
  Rejected
}

enum RequestType {
  Petition
  Custom
}
